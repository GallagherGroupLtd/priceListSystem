{
  "_version": "1.85.0",
  "sap.app": {
    "id": "pricelistapp.applicationlog",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:worklist",
      "version": "1.25.0",
      "toolsId": "2fe159c5-e01b-4e6d-95ef-8520426329c9"
    },
    "crossNavigation": {
      "inbounds": {
        "applicationlog-display": {
          "semanticObject": "AppLog",
          "action": "display",
          "title": "{{appTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/price-list/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "priceListSystem.service"
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.149.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "pricelistapp.applicationlog.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "pricelistapp.applicationlog.ext.controller.ApplicationLogListExt"
          },
          "sap.fe.templates.ObjectPage.ObjectPageController": {
            "controllerName": "pricelistapp.applicationlog.ext.controller.PricelistNotificationEventObjectPageExt"
          }
        }
      }
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ApplicationLogHome",
          "target": "ApplicationLogHome"
        },
        {
          "pattern": "ApplicationLog:?query:",
          "name": "ApplicationLogList",
          "target": "ApplicationLogList"
        },
        {
          "pattern": "ApplicationLog({key}):?query:",
          "name": "ApplicationLogObjectPage",
          "target": "ApplicationLogObjectPage"
        },
        {
          "pattern": "ApplicationChangeLog:?query:",
          "name": "ApplicationChangeLogList",
          "target": "ApplicationChangeLogList"
        },
        {
          "pattern": "ApplicationChangeLog({key}):?query:",
          "name": "ApplicationChangeLogObjectPage",
          "target": "ApplicationChangeLogObjectPage"
        },
        {
          "pattern": "PricelistNotificationEvent:?query:",
          "name": "PricelistNotificationEventList",
          "target": "PricelistNotificationEventList"
        },
        {
          "pattern": "PricelistNotificationEvent({key}):?query:",
          "name": "PricelistNotificationEventObjectPage",
          "target": "PricelistNotificationEventObjectPage"
        }
      ],
      "targets": {
        "ApplicationLogHome": {
          "type": "View",
          "id": "ApplicationLogHome",
          "name": "ApplicationLogHome",
          "path": "pricelistapp.applicationlog.view",
          "viewType": "XML"
        },
        "ApplicationLogList": {
          "type": "Component",
          "id": "ApplicationLogList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ApplicationLog",
              "variantManagement": "Page",
              "hideFilterBar": false,
              "initialLoad": "Enabled",
              "navigation": {
                "ApplicationLog": {
                  "detail": {
                    "route": "ApplicationLogObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "useExportToExcel": true
                  }
                }
              }
            }
          }
        },
        "ApplicationLogObjectPage": {
          "type": "Component",
          "id": "ApplicationLogObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/ApplicationLog",
              "content": {
                "header": {
                  "actions": {
                    "BackToList": {
                      "text": "Back to User Engagement",
                      "press": "pricelistapp.applicationlog.ext.controller.ApplicationLogObjectPageActions.onBackToUserEngagement",
                      "visible": true,
                      "enabled": true
                    }
                  }
                }
              }
            }
          }
        },
        "ApplicationChangeLogList": {
          "type": "Component",
          "id": "ApplicationChangeLogList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ApplicationChangeLog",
              "variantManagement": "Page",
              "hideFilterBar": false,
              "initialLoad": "Enabled",
              "navigation": {
                "ApplicationChangeLog": {
                  "detail": {
                    "route": "ApplicationChangeLogObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "useExportToExcel": true
                  }
                }
              }
            }
          }
        },
        "ApplicationChangeLogObjectPage": {
          "type": "Component",
          "id": "ApplicationChangeLogObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/ApplicationChangeLog",
              "content": {
                "header": {
                  "actions": {
                    "BackToList": {
                      "text": "Back to Application Changes",
                      "press": "pricelistapp.applicationlog.ext.controller.ApplicationLogObjectPageActions.onBackToApplicationChanges",
                      "visible": true,
                      "enabled": true
                    }
                  }
                }
              }
            }
          }
        },
        "PricelistNotificationEventList": {
          "type": "Component",
          "id": "PricelistNotificationEventList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/PricelistNotificationEvent",
              "variantManagement": "Page",
              "hideFilterBar": false,
              "initialLoad": "Enabled",
              "navigation": {
                "PricelistNotificationEvent": {
                  "detail": {
                    "route": "PricelistNotificationEventObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "useExportToExcel": true
                  }
                }
              }
            }
          }
        },
        "PricelistNotificationEventObjectPage": {
          "type": "Component",
          "id": "PricelistNotificationEventObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/PricelistNotificationEvent",
              "content": {
                "header": {
                  "actions": {
                    "BackToList": {
                      "text": "Back to Pricelist Changes",
                      "press": "pricelistapp.applicationlog.ext.controller.ApplicationLogObjectPageActions.onBackToPricelistChanges",
                      "visible": true,
                      "enabled": true
                    }
                  }
                },
                "body": {
                  "sections": {
                    "PricelistChangeComparison": {
                      "template": "pricelistapp.applicationlog.ext.fragment.PricelistChangeComparison",
                      "title": "Detailed Changes"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
