<core:FragmentDefinition 
    xmlns:core="sap.ui.core" 
    xmlns="sap.m">
    <VBox id="VBox" width="100%">
        <Title
            id="NotesTitle"
            text="Notes"
            level="H5" />
        <Text
            id="NotesContextText"
            text="{Notes}"
            width="75%"
            wrapping="true"
            renderWhitespace="true" />
    </VBox>
</core:FragmentDefinition>