<core:FragmentDefinition 
    xmlns:core="sap.ui.core" 
    xmlns="sap.m" 
    xmlns:t="sap.ui.table"
    xmlns:mvc="sap.ui.core.mvc" 
    xmlns:macros="sap.fe.macros"
    xmlns:dnd="sap.ui.core.dnd">

    <VBox id="ProductListVBox" core:require="{ handler: 'pricelistapp/pricelistdisplay/ext/controller/ProductList'}">
        <OverflowToolbar id="ProductListToolbar">
            <Title
                id="ProductListTitle"
                text="Product List" />
            <ToolbarSpacer id="ProductListToolbarSep_1" />
            <Button
                id="ProductListExpandBtn"
                text="Expand"
                icon="sap-icon://expand"
                tooltip="Expand"
                visible="true"
                press="handler.onExpand"/>
            <Button
                id="ProductListCollapseBtn"
                text="Collapse"
                icon="sap-icon://collapse"
                tooltip="Collapse"
                visible="true"
                press="handler.onCollapse"/>
            <Button
                id="ProductListExpandAllBtn"
                text="Expand All"
                icon="sap-icon://expand-all"
                tooltip="Expand all"
                visible="true"
                press="handler.onExpandAll"/>
            <Button
                id="ProductListCollapseAllBtn"
                text="Collapse"
                icon="sap-icon://collapse-all"
                tooltip="Collapse all"
                visible="false"
                press="handler.onCollapseAll"/>
            <Button
                id="ProductListSortBtn"
                icon="sap-icon://sort"
                tooltip="Sort by Description"
                press="handler.onSortProducts" />
            <Button
                id="ProductListHierarchyFilterBtn"
                icon="sap-icon://filter"
                tooltip="Filter"
                press="handler.onOpenHierarchyFilter"/>
            <Button
                id="ProductListColumnSettingsBtn"
                icon="sap-icon://action-settings"
                tooltip="Column Settings"
                press="handler.onOpenDisplayColumnSettings" />
            <Button
                id="ProductListRetrieveDiscountBtn"
                text="Retrieve Discount"
                icon="sap-icon://customer-financial-fact-sheet"
                tooltip="Retrieve discount information for a customer"
                visible="{jsonModel>/discountUserContext/IsInternalUser}"
                enabled="{= !${jsonModel>/discountLoading} }"
                press="handler.onRetrieveDiscounts" />
            <ToolbarSeparator id="ProductListToolbarSep_4"/>
            <MenuButton
                id="ProductTreeExportMenuBtn"
                icon="sap-icon://excel-attachment"
                tooltip="Export Excel"
                buttonMode="Split"
                useDefaultActionOnly="true"
                defaultAction="handler.onExportExcel">
                <menu>                    
                    <Menu id="ProductTreeExportMenu">
                        <MenuItem
                            id="ProductTreeExportMenuItem"
                            text="Export"
                            press="handler.onExportExcel" />                        
                        <MenuItem
                            id="ProductTreeExportAsMenuItem"
                            text="Export As..."
                            press="handler.onExportExcelAs" />
                    </Menu>
                </menu>
            </MenuButton>
        </OverflowToolbar>
        <t:TreeTable
            id="ProductPriceListTreeTable"
            selectionMode="Single"
            enableColumnReordering="true"
            enableColumnFreeze="true"
            rowSelectionChange="handler.onSelectionChange"
            width="100%"
            rows="{
                path: 'jsonModel>/productPriceList',
                parameters: { arrayNames: ['children'] } 
            }">
            <t:columns>

                <t:Column id="ColCategoriesAndProducts" width="30%" >
                    <Label id="LblCategoriesAndProducts" text="Categories and Products" textAlign="Center" width="100%"/>
                    <t:template>
                        <Text id="TxtCategoriesAndProducts" text="{jsonModel>Title}" wrapping="false" />
                    </t:template>
                </t:Column>

                <t:Column id="ColDescription" width="20%">
                    <Label id="LblDescription" text="Description" textAlign="Center" width="100%"/>
                    <t:template>
                        <Text id="TxtDescription" text="{= ${jsonModel>Kind} === 'Product' ? ${jsonModel>Description} : '' }" wrapping="false" />
                    </t:template>
                </t:Column>

                <t:Column id="ColCountryOfOrigin" width="7%" hAlign="Center">
                    <Label id="LblCountryOfOrigin" text="Country of Origin" textAlign="Center" width="100%"/>
                    <t:template>
                        <Text id="TxtCountryOfOrigin" text="{= ${jsonModel>Kind} === 'Product' ? (${jsonModel>CountryOfOrigin} || '') : '' }" wrapping="false"/>
                    </t:template>
                </t:Column>

                <t:Column id="ColPriceCurrency" width="7%" hAlign="Center">
                    <Label id="LblPriceCurrency" text="Price (Currency)" textAlign="Center" width="100%"/>
                    <t:template>
                        <Text id="TxtPriceCurrency" text="{= ${jsonModel>Kind} === 'Product' ? (${jsonModel>Price} || '') + ' ' + (${jsonModel>PriceUnit} || '') : '' }" />
                    </t:template>
                </t:Column>

                <t:Column id="ColValidity" width="8%" hAlign="Center">
                    <Label id="LblValidity" text="Price Validity" textAlign="Center" width="100%"/>
                    <t:template>
                        <Text id="TxtValidity" text="{= ${jsonModel>Kind} === 'Product' ? (${jsonModel>PriceValidFrom} || '') : '' }"/>
                    </t:template>
                </t:Column>

                <t:Column id="ColDiscountRate" width="8%" hAlign="Center">
                    <Label id="LblDiscountRate" text="Discount" textAlign="Center" width="100%" />
                    <t:template>
                        <Text id="TxtDiscountRate" text="{= ${jsonModel>Kind} === 'Product' ? (${jsonModel>DiscountRate} || '') : '' }" />
                    </t:template>
                </t:Column>

                <t:Column id="ColDiscountEffectiveDate" width="9%" hAlign="Center">
                    <Label id="LblDiscountEffectiveDate" text="Discount Effective Date" textAlign="Center" width="100%" />
                    <t:template>
                        <Text id="TxtDiscountEffectiveDate" text="{= ${jsonModel>Kind} === 'Product' ? (${jsonModel>DiscountValidFrom} || '') : '' }" />
                    </t:template>
                </t:Column>

                <t:Column id="ColDiscountExpiryDate" width="9%" hAlign="Center">
                    <Label id="LblDiscountExpiryDate" text="Discount Expiry Date" textAlign="Center" width="100%" />
                    <t:template>
                        <Text id="TxtDiscountExpiryDate" text="{= ${jsonModel>Kind} === 'Product' ? (${jsonModel>DiscountValidTo} || '') : '' }" />
                    </t:template>
                </t:Column>

                <t:Column id="ColPriceChangeIndicator" width="5%" hAlign="Center">
                    <Label id="LblPriceChangeIndicator" text="Price Change Indicator" textAlign="Center" width="100%"/>
                    <t:template>
                        <Switch id="SwitchPriceChangeIndicator" type="AcceptReject" state="{jsonModel>PriceChangeIndicator}" enabled="false" visible="{= ${jsonModel>Kind} === 'Product' }" />
                    </t:template>
                </t:Column>

                <t:Column id="ColStatus" width="6%" hAlign="Center">
                    <Label id="LblStatus" text="Status" textAlign="Center" width="100%"/>
                    <t:template>
                        <Text id="TxtStatus" text="{= ${jsonModel>Kind} === 'Product' ? ${jsonModel>Status} : '' }" />
                    </t:template>
                </t:Column>

                <t:Column id="ColStatusValidity" width="8%" hAlign="Center">
                    <Label id="LblStatusValidity" text="Status Validity" textAlign="Center" width="100%"/>
                    <t:template>
                        <Text id="TxtStatusValidity" text="{= ${jsonModel>Kind} === 'Product' ? (${jsonModel>StatusValidFromDate} || '') + ' - ' + (${jsonModel>StatusValidToDate} || '') : '' }" />
                    </t:template>
                </t:Column>

                <t:Column id="ColSupplier" width="8%" hAlign="Center">
                    <Label id="LblSupplier" text="Supplier" textAlign="Center" width="100%"/>
                    <t:template>
                        <Text id="TxtSupplier" text="{= ${jsonModel>Kind} === 'Product' ? (${jsonModel>Supplier} || '') : '' }" wrapping="false" />
                    </t:template>
                </t:Column>

                <t:Column id="ColSupplierSKU" width="6%" hAlign="Center">
                    <Label id="LblSupplierSKU" text="Supplier SKU" textAlign="Center" width="100%"/>
                    <t:template>
                        <Text id="TxtSupplierSKU" text="{= ${jsonModel>Kind} === 'Product' ? (${jsonModel>SupplierSKU} || '') : '' }" wrapping="false" />
                    </t:template>
                </t:Column>

            </t:columns>
        </t:TreeTable>

    </VBox>
</core:FragmentDefinition>